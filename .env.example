# Секрет подписи/шифрования taskToken (ARCHITECTURE §5.3). Задаётся в env Vercel / GitHub Actions.
# Значение не коммитить. Минимум 32 символа (на Vercel без него сервер заданий падает).
# Сгенерировать: openssl rand -base64 48
TASK_SIGNING_SECRET=

# --- Облако (необязательно). Без NEXT_PUBLIC_SUPABASE_* приложение работает локально, вход скрыт. ---
# Supabase: Project Settings -> API. Только anon (публичный) ключ; service_role сюда НЕ класть.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секрет для Vercel Cron (суточный пинг Supabase). Сгенерировать: openssl rand -hex 32
CRON_SECRET=

# Rate limit в запросах/мин на клиента (необязательно). Дефолты: 30 (next/grade), 120 (/api/history).
# RATE_LIMIT_TASKS_PER_MIN=30
# RATE_LIMIT_HISTORY_PER_MIN=120
